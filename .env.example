# Generate real values with: node scripts/dev-env.mjs   (never commit .env)
# ---- Docker Compose secrets
POSTGRES_PASSWORD=
FLEXA_OWNER_PASSWORD=
FLEXA_APP_PASSWORD=
FLEXA_RELAY_PASSWORD=

# ---- Shared (api, worker) — validated by packages/config (Zod)
NODE_ENV=development
LOG_LEVEL=info
DATABASE_URL=postgres://flexa_app:<app_password>@localhost:5432/flexa
REDIS_URL=redis://localhost:6379
# 32 random bytes, base64. Wraps every tenant data key (ADR-0003 §7).
FLEXA_MASTER_KEY=
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=flexa-api

# ---- API
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
WEB_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
# Ed25519 private key (PKCS#8 PEM), base64 encoded on one line.
JWT_PRIVATE_KEY_B64=
JWT_ISSUER=flexa
ACCESS_TOKEN_TTL_SECONDS=600
REFRESH_TOKEN_TTL_DAYS=30
CSRF_SECRET=
# true in production (Secure cookies, __Host- prefix). false only for plain-http local runs.
COOKIE_SECURE=true
RATE_LIMIT_PER_MINUTE=600
AUTH_RATE_LIMIT_PER_MINUTE=20
TRUST_PROXY=false
# Development/test only; refused in production.
OIDC_ALLOW_INSECURE_LOCALHOST=false

# ---- Worker
SMTP_URL=smtp://localhost:1025
MAIL_FROM=Flexa <no-reply@flexa.local>
WORKER_HEALTH_PORT=4100

# ---- Migrations (packages/db)
DATABASE_OWNER_URL=postgres://flexa_owner:<owner_password>@localhost:5432/flexa
