{
  "name": "flexa",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint && eslint scripts",
    "test": "turbo run test",
    "test:int": "turbo run test:int --concurrency=1",
    "e2e": "pnpm --filter @flexa/web e2e",
    "check": "node scripts/contrast-report.mjs && node scripts/check-permission-matrix.mjs && node scripts/check-module-catalog.mjs",
    "db:migrate": "pnpm --filter @flexa/db migrate",
    "db:seed": "pnpm --filter @flexa/db seed",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "20.5.3",
    "@commitlint/config-conventional": "20.5.3",
    "@eslint/js": "9.39.5",
    "@types/node": "24.10.4",
    "ajv": "8.17.1",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "globals": "16.5.0",
    "husky": "9.1.7",
    "lint-staged": "16.4.0",
    "prettier": "3.10.1",
    "turbo": "2.11.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "yaml": "2.8.1"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yaml,yml,css}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "esbuild",
      "sharp",
      "cpu-features",
      "ssh2",
      "protobufjs"
    ]
  }
}
