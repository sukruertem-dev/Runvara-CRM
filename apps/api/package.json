    "@flexa/workflow": "workspace:*",
    "@scalar/fastify-api-reference": "1.82.1",
    "bullmq": "5.81.5",
    "fastify": "5.12.8",
    "ioredis": "5.11.1",
    "openid-client": "6.9.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@swc/core": "1.16.22",
    "@testcontainers/postgresql": "11.14.0",
    "oauth2-mock-server": "8.2.3",
    "testcontainers": "11.14.0",
    "unplugin-swc": "1.6.0",
    "vitest": "3.2.7"
