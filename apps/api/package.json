{
  "name": "@flexa/api",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node --enable-source-maps dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "test": "vitest run --config vitest.config.ts",
    "test:int": "vitest run --config vitest.int.config.ts",
    "test:perf": "vitest run --config vitest.perf.config.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@fastify/cors": "11.4.3",
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "10.3.0",
    "@nestjs/common": "11.2.11",
    "@nestjs/core": "11.2.11",
    "@nestjs/platform-fastify": "11.2.11",
    "@opentelemetry/exporter-trace-otlp-http": "0.301.2",
    "@opentelemetry/instrumentation-http": "0.301.2",
    "@opentelemetry/instrumentation-pg": "0.78.0",
    "@opentelemetry/sdk-node": "0.301.2",
    "@flexa/authz": "workspace:*",
    "@flexa/config": "workspace:*",
    "@flexa/contracts": "workspace:*",
    "@flexa/db": "workspace:*",
