{
  "name": "@runvara/db",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./testing": { "types": "./dist/testing.d.ts", "default": "./dist/testing.js" }
  },
  "files": ["dist", "migrations", "sql"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "migrate": "node dist/cli.js",
    "test:int": "vitest run --config vitest.int.config.ts"
  },
  "dependencies": {
    "@runvara/config": "workspace:*",
    "drizzle-orm": "0.44.7",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "11.14.0",
    "@types/pg": "8.15.6",
    "testcontainers": "11.14.0",
    "vitest": "3.2.7"
  }
}
