{
  "$schema": "./tokens.schema.json",
  "meta": {
    "name": "runvara",
    "version": "0.1.0",
    "source": "CRM_TASK_PLATFORM_PROMPT.md §12.4–12.5, corrections in docs/requirements-review.md §D",
    "rules": [
      "Components must reference tokens only; literal colors are forbidden (lint).",
      "Every color token exists in both themes (parity is checked by scripts/contrast-report.mjs).",
      "Tenant branding supplies one brand color; accent, accent-hover, accent-soft, accent-btn, accent-btn-hover are derived per theme (ADR-0011) and must pass every contrastCheck marked tenantAccent, otherwise darkened/lightened automatically or rejected."
    ]
  },
  "color": {
    "light": {
      "bg-canvas": "#F4F1EA",
      "bg-surface": "#FFFFFF",
      "bg-subtle": "#ECE8DF",
      "bg-raised": "#FFFFFF",
      "border": "#E2DDD3",
      "border-strong": "#7E8187",
      "text-primary": "#2B2D31",
      "text-secondary": "#5C5F66",
      "primary": "#2B2D31",
      "on-primary": "#F4F1EA",
      "accent": "#C8102E",
      "accent-hover": "#9E0C24",
      "accent-soft": "#FBE7E9",
      "accent-btn": "#C8102E",
      "accent-btn-hover": "#9E0C24",
      "on-accent": "#FFFFFF",
      "spark": "#E63946",
      "b2b": "#3A3C41",
      "b2b-soft": "#E6E4DF",
      "b2c": "#C8102E",
      "b2c-soft": "#FBE7E9",
      "success": "#1E6B45",
      "success-soft": "#E3F2EA",
      "warning": "#8A5A00",
      "warning-soft": "#FFF2D6",
      "danger": "#9B1B1F",
      "danger-soft": "#FBE3E1",
      "info": "#2F5272",
      "info-soft": "#E6EDF3",
      "chart-1": "#2B2D31",
      "chart-2": "#C8102E",
      "chart-3": "#7E8187",
      "chart-4": "#D9545D",
      "chart-5": "#7A0A1C"
    },
    "dark": {
      "bg-canvas": "#1C1D20",
      "bg-surface": "#25272B",
      "bg-subtle": "#2E3035",
      "bg-raised": "#2E3035",
      "border": "#3A3C41",
      "border-strong": "#80838A",
      "text-primary": "#F4F1EA",
      "text-secondary": "#B9B5AC",
      "primary": "#F4F1EA",
      "on-primary": "#1C1D20",
      "accent": "#FF6B70",
      "accent-hover": "#FF8A8E",
      "accent-soft": "#3A2326",
      "accent-btn": "#C8102E",
      "accent-btn-hover": "#A50D26",
      "on-accent": "#F4F1EA",
      "spark": "#E63946",
      "b2b": "#D4D0C7",
      "b2b-soft": "#34363B",
      "b2c": "#FF6B70",
      "b2c-soft": "#3A2326",
      "success": "#4ADE9A",
      "success-soft": "#1F3329",
      "warning": "#FFC247",
      "warning-soft": "#3A3020",
      "danger": "#FF8A80",
      "danger-soft": "#3D2624",
      "info": "#8AB4E0",
      "info-soft": "#22303D",
      "chart-1": "#D4D0C7",
      "chart-2": "#FF6B70",
      "chart-3": "#8A8D93",
      "chart-4": "#E8858C",
      "chart-5": "#F2B8BC"
    }
  },
  "buttonMap": {
    "light": { "primary": { "bg": "primary", "fg": "on-primary" }, "accent": { "bg": "accent-btn", "fg": "on-accent" } },
    "dark": { "primary": { "bg": "accent-btn", "fg": "on-accent" }, "accent": { "bg": "accent-btn", "fg": "on-accent" } }
  },
  "font": {
    "display": "'Space Grotesk', Inter, system-ui, sans-serif",
    "body": "Inter, system-ui, sans-serif",
    "weights": { "display": [500, 700], "body": [400, 500] },
    "scale": [12, 14, 16, 20, 24, 32, 44]
  },
  "radius": { "input": "8px", "btn": "12px", "card": "16px", "hero": "20px", "logoTileRatio": 0.26 },
  "shadow": {
    "light": { "card": "0 1px 2px rgba(43,45,49,.06), 0 8px 24px rgba(43,45,49,.08)" },
    "dark": { "card": "none" }
  },
  "density": { "comfortable": { "rowHeight": 40, "controlHeight": 36 }, "compact": { "rowHeight": 32, "controlHeight": 28 } },
  "motion": { "fast": "120ms", "base": "200ms", "slow": "320ms", "easing": "cubic-bezier(.2,.8,.2,1)", "reducedMotion": "disable non-essential transitions; spark pulse becomes static dot" },
  "contrastChecks": [
    { "fg": "text-primary", "bg": "bg-canvas", "min": 4.5, "kind": "text" },
    { "fg": "text-primary", "bg": "bg-surface", "min": 4.5, "kind": "text" },
    { "fg": "text-primary", "bg": "bg-subtle", "min": 4.5, "kind": "text" },
    { "fg": "text-primary", "bg": "bg-raised", "min": 4.5, "kind": "text" },
    { "fg": "text-secondary", "bg": "bg-canvas", "min": 4.5, "kind": "text" },
    { "fg": "text-secondary", "bg": "bg-surface", "min": 4.5, "kind": "text" },
    { "fg": "text-secondary", "bg": "bg-subtle", "min": 4.5, "kind": "text" },
    { "fg": "text-secondary", "bg": "bg-raised", "min": 4.5, "kind": "text" },
    { "fg": "on-primary", "bg": "primary", "min": 4.5, "kind": "text" },
    { "fg": "on-accent", "bg": "accent-btn", "min": 4.5, "kind": "text", "tenantAccent": true },
    { "fg": "on-accent", "bg": "accent-btn-hover", "min": 4.5, "kind": "text", "tenantAccent": true },
    { "fg": "accent", "bg": "bg-canvas", "min": 4.5, "kind": "text", "tenantAccent": true },
    { "fg": "accent", "bg": "bg-surface", "min": 4.5, "kind": "text", "tenantAccent": true },
    { "fg": "accent", "bg": "bg-raised", "min": 4.5, "kind": "text", "tenantAccent": true },
    { "fg": "accent", "bg": "accent-soft", "min": 4.5, "kind": "text", "tenantAccent": true },
    { "fg": "accent-hover", "bg": "bg-surface", "min": 4.5, "kind": "text", "theme": "dark", "tenantAccent": true },
    { "fg": "b2b", "bg": "b2b-soft", "min": 4.5, "kind": "text" },
    { "fg": "b2b", "bg": "bg-surface", "min": 4.5, "kind": "text" },
    { "fg": "b2c", "bg": "b2c-soft", "min": 4.5, "kind": "text" },
    { "fg": "b2c", "bg": "bg-surface", "min": 4.5, "kind": "text" },
    { "fg": "success", "bg": "success-soft", "min": 4.5, "kind": "text" },
    { "fg": "success", "bg": "bg-surface", "min": 4.5, "kind": "text" },
    { "fg": "warning", "bg": "warning-soft", "min": 4.5, "kind": "text" },
    { "fg": "warning", "bg": "bg-surface", "min": 4.5, "kind": "text" },
    { "fg": "danger", "bg": "danger-soft", "min": 4.5, "kind": "text" },
    { "fg": "danger", "bg": "bg-surface", "min": 4.5, "kind": "text" },
    { "fg": "info", "bg": "info-soft", "min": 4.5, "kind": "text" },
    { "fg": "info", "bg": "bg-surface", "min": 4.5, "kind": "text" },
    { "fg": "border-strong", "bg": "bg-surface", "min": 3, "kind": "non-text" },
    { "fg": "border-strong", "bg": "bg-canvas", "min": 3, "kind": "non-text" },
    { "fg": "border-strong", "bg": "bg-subtle", "min": 3, "kind": "non-text" },
    { "fg": "accent", "bg": "bg-surface", "min": 3, "kind": "non-text", "note": "focus ring" },
    { "fg": "spark", "bg": "bg-surface", "min": 3, "kind": "non-text", "note": "live/notification dot" },
    { "fg": "chart-1", "bg": "bg-surface", "min": 3, "kind": "non-text" },
    { "fg": "chart-2", "bg": "bg-surface", "min": 3, "kind": "non-text" },
    { "fg": "chart-3", "bg": "bg-surface", "min": 3, "kind": "non-text" },
    { "fg": "chart-4", "bg": "bg-surface", "min": 3, "kind": "non-text" },
    { "fg": "chart-5", "bg": "bg-surface", "min": 3, "kind": "non-text" }
  ]
}
