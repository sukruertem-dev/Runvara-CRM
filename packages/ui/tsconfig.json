{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "lib": ["dom", "dom.iterable", "ES2023"],
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "types": ["vitest/globals", "@testing-library/jest-dom"]
  },
  "include": ["src", ".storybook/*.ts", ".storybook/*.tsx", "vitest.config.ts"]
}
