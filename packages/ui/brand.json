  "modules": [
    { "id": "crm", "name": "CRM", "description": "Customer Relationship Management" },
    { "id": "tasks", "name": "Task Management", "description": "Task and Project Management" },
    { "id": "sales", "name": "Sales Operations", "description": "Sales Pipeline and Operations" }
