      "iconLayout": "F symbol only",
      "lightBackgroundWordmark": "#1A1B1F",
      "darkBackgroundWordmark": "#F8F9FC"
    }
  },
  "colors": {
    "primary": "#7B3CFF",
    "primaryLight": "#B68CFF",
    "lavender": "#F2ECFF",
    "surface": "#F8F9FC",
    "charcoal": "#2B2D31",
    "charcoalDark": "#1A1B1F",
    "neutralGray": "#8B93A7",
    "white": "#FFFFFF"
