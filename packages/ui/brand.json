{
  "project": "Flexa",
  "version": "1.0.0",
  "productType": "Modular SaaS Platform",
  "description": "Unified CRM, Task Management and Sales Operations",
  "brand": {
    "name": "Flexa",
    "tagline": "İşini Tek Platformda Yönet",
    "personality": ["Modern", "Professional", "Innovative", "Modular", "Premium"],
    "logo": {
      "concept": "Layered ribbon-style F symbol",
