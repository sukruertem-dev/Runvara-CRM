{
  "name": "@flexa/config",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "gen": "node scripts/gen-tokens.mjs",
    "build": "pnpm gen && tsc -p tsconfig.build.json",
    "typecheck": "pnpm gen && tsc -p tsconfig.json --noEmit",
    "lint": "pnpm gen && eslint src",
    "test": "pnpm gen && vitest run"
  },
  "dependencies": {
    "ajv": "8.17.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "vitest": "3.2.7"
  }
}
