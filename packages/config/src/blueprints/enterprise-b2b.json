    "taskWorkflows": [
      {
        "key": "approval",
        "name": "Onay akışı",
        "statuses": [
          {
            "key": "draft",
            "label": {
              "tr": "Taslak",
              "en": "Draft"
            },
            "category": "open",
            "isInitial": true
          },
          {
            "key": "in_review",
            "label": {
              "tr": "İncelemede",
              "en": "In review"
            },
            "category": "in_progress",
            "colorToken": "info"
          },
          {
            "key": "approved",
            "label": {
              "tr": "Onaylandı",
              "en": "Approved"
            },
            "category": "closed",
            "colorToken": "success"
          },
          {
            "key": "rejected",
            "label": {
              "tr": "Reddedildi",
              "en": "Rejected"
            },
            "category": "closed",
            "colorToken": "danger"
          }
        ],
        "transitions": [
          {
            "key": "submit",
            "label": {
              "tr": "İncelemeye gönder",
              "en": "Submit for review"
            },
            "from": "draft",
            "to": "in_review"
          },
          {
            "key": "approve",
            "label": {
              "tr": "Onayla",
              "en": "Approve"
            },
            "from": "in_review",
            "to": "approved"
          },
          {
            "key": "reject",
            "label": {
              "tr": "Reddet",
              "en": "Reject"
            },
            "from": "in_review",
            "to": "rejected"
          },
          {
            "key": "revise",
            "label": {
              "tr": "Düzeltmeye gönder",
              "en": "Send back"
            },
            "from": "rejected",
            "to": "draft"
          }
        ]
      }
