{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["API_INTERNAL_URL", "NEXT_TELEMETRY_DISABLED"],
      "inputs": ["src/**", "tsconfig*.json", "package.json", "migrations/**", "next.config.*", "app/**", "lib/**", "public/**", "scripts/**"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "generated/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test:int": {
      "dependsOn": ["^build"],
      "cache": false,
      "outputs": []
    }
  }
}
