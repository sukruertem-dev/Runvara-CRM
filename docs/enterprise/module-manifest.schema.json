{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flexa.app/schemas/module-manifest.v1.json",
  "title": "Flexa module manifest",
  "description": "Declared by every module in packages/modules/manifests/<id>.ts and validated at boot (ADR-0014).",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "displayNameKey", "dependsOn", "permissions", "routes", "menu", "jobs", "events", "configKeys", "planEntitlement", "defaultConfig"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,31}$" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "displayNameKey": { "type": "string", "pattern": "^module\\.[a-z0-9_]+\\.name$", "description": "i18n key; UI never shows the technical id (§12.3)" },
    "descriptionKey": { "type": "string", "pattern": "^module\\.[a-z0-9_]+\\.description$" },
    "family": { "type": "integer", "minimum": 1, "maximum": 13, "description": "Row number in §12.3 module family table" },
    "dependsOn": {
      "type": "array",
      "description": "Conjunctive normal form: every inner group must be satisfied; a group is satisfied when ANY of its module ids is enabled. [] = no dependency.",
      "items": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/moduleId" } }
    },
    "optionalIntegrations": { "type": "array", "items": { "$ref": "#/$defs/moduleId" }, "uniqueItems": true, "description": "Used when enabled, never required (e.g. ai_assistant → crm)" },
    "permissions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "labelKey"],
        "properties": {
          "key": { "type": "string", "pattern": "^[a-z0-9_*]+(\\.[a-z0-9_*]+){1,3}$" },
          "labelKey": { "type": "string" },
          "sensitive": { "type": "boolean", "default": false },
          "fieldPolicyFields": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "resources": {
      "type": "array",
      "description": "Record resource types owned by this module (registered in record_registry / record_types).",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "table", "segmentMode"],
        "properties": {
          "type": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "table": { "type": "string" },
          "segmentMode": { "enum": ["identity", "transactional", "contextual", "none"] },
          "mentionFields": { "type": "array", "items": { "type": "string" } },
          "customFields": { "type": "boolean", "default": true },
          "workflow": { "type": "boolean", "default": false }
        }
      }
    },
    "routes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiPrefixes"],
      "properties": {
        "apiPrefixes": { "type": "array", "minItems": 0, "items": { "type": "string", "pattern": "^/[a-z0-9/_-]+$" } }
      }
    },
    "menu": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "labelKey", "path", "icon", "requires"],
        "properties": {
          "id": { "type": "string" },
          "labelKey": { "type": "string" },
          "path": { "type": "string", "pattern": "^/" },
          "icon": { "type": "string", "description": "Icon id from the Flexa line icon set (2px, round caps)" },
          "requires": { "type": "array", "items": { "type": "string" }, "description": "Permission keys; ANY grants visibility" },
          "salesModes": { "type": "array", "items": { "enum": ["b2b_only", "b2c_only", "both"] } }
        }
      }
    },
    "jobs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "kind"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z0-9_.]+$" },
          "kind": { "enum": ["cron", "event", "on_demand"] },
          "cron": { "type": "string" },
          "perTenantConcurrency": { "type": "integer", "minimum": 1, "default": 2 }
        }
      }
    },
    "events": {
      "type": "object",
      "additionalProperties": false,
      "required": ["publishes", "consumes"],
      "properties": {
        "publishes": { "type": "array", "items": { "type": "string", "pattern": "^[a-z_]+(\\.[a-z_]+)+$" } },
        "consumes": { "type": "array", "items": { "type": "string", "pattern": "^[a-z_*]+(\\.[a-z_*]+)+$" } }
      }
    },
    "configKeys": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9_]+(\\.[a-z0-9_]+)+$" } },
    "planEntitlement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["includedIn"],
      "properties": {
        "includedIn": { "type": "array", "items": { "enum": ["starter", "growth", "enterprise"] } },
        "addOn": { "type": "boolean", "default": false }
      }
    },
    "defaultConfig": { "type": "object" },
    "alwaysOn": { "type": "boolean", "default": false, "description": "true only for core" }
  },
  "$defs": {
    "moduleId": { "enum": ["core", "crm", "sales_b2b", "sales_b2c", "sales_tracking", "call_center", "dialer", "call_qa", "data_service", "automation_sla", "reporting_advanced", "api_webhooks", "ai_assistant"] }
  }
}
